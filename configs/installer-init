#!/bin/sh
# PID 1: physical-console installer preparation; no automatic disk writes.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
/bin/busybox --install -s /bin
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid devtmpfs /dev
mount -t tmpfs -o mode=0755,nosuid,nodev,size=64m tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev,size=64m tmpfs /tmp
exec </dev/console >/dev/console 2>&1

echo 'A733 installer preparation: unrestricted physical root console.'
echo 'No disk filesystem, swap, network listener or automatic physical writer is started.'
echo 'Keep payloads on identified fixed/external storage, not in /run, /tmp or SD.'
modprobe nvme 2>/dev/null || :
# Pass sysfs paths as arguments: names such as Fixed MDIO bus.0 contain spaces.
find /sys/devices -name modalias -exec sh -c '
    if read -r alias < "$1"; then
        modprobe "$alias" 2>/dev/null || :
    fi
' sh {} \; 2>/dev/null
uname -a
cat /proc/cmdline
lsblk -b -o NAME,SIZE,MODEL,SERIAL,TYPE,FSTYPE,MOUNTPOINTS || :
ls -l /dev/kvm 2>/dev/null || :
ip link set lo up || :
for net in /sys/class/net/*; do
    [ -e "$net/device" ] && [ ! -d "$net/wireless" ] && [ ! -d "$net/phy80211" ] || continue
    [ "$(cat "$net/type" 2>/dev/null)" = 1 ] || continue
    interface=${net##*/}
    ip link set "$interface" up || continue
    udhcpc -f -n -q -t 3 -T 3 -i "$interface" -s /etc/udhcpc.script || :
done
ip addr
ip route
printf '%s\n' 'Read-only target report: /usr/bin/python3 -I -B /usr/lib/a733-installer/plan-nvme.py --target IDENTIFIED_NVME_PATH'
printf '%s\n' 'Physical installation, SPI programming and actual KVM acceptance remain pending.'
while :; do
    echo 'Starting installer preparation shell; exit restarts it.'
    if command -v setsid >/dev/null 2>&1 && command -v cttyhack >/dev/null 2>&1; then
        setsid cttyhack /bin/sh -i </dev/console >/dev/console 2>&1
    else
        /bin/sh -i </dev/console >/dev/console 2>&1
    fi
    sleep 1
done
