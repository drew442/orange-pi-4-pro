[Unit]
Description=A733 selected Ethernet management SSH
Wants=systemd-networkd.service
After=systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/lib/orangepi-hypervisor/host-management.py serve
Restart=on-failure
RestartSec=10s
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
UMask=0077

[Install]
WantedBy=multi-user.target
