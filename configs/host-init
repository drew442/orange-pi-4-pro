#!/bin/sh
# A733 host initramfs PID 1. Sourcing defines functions only, for fixture tests.
# Production dependencies are fixed; never source configuration as shell code.
hi_bb() { /bin/busybox "$@"; }
hi_resolver() { . /etc/host-storage-resolver.sh; }
hi_error() { printf '%s\n' "A733 host handoff: $*" >&2; return 1; }
hi_match() {
    case "$1" in *'
'*) return 1 ;; esac
    printf '%s\n' "$1" | hi_bb grep -Eq "$2"
}
hi_regular() { hi_bb test -f "$1" && ! hi_bb test -L "$1"; }
hi_directory() { hi_bb test -d "$1" && ! hi_bb test -L "$1"; }
hi_size() { hi_bb stat -c %s "$1"; }
# Bound malformed metadata before capture, and bound I/O even if it grows after
# stat. Callers compare the captured bytes with the file to reject truncation.
hi_bounded_read() {
    local size
    size=$(hi_size "$1") || return 1
    hi_match "$size" '^[0-9]+$' && [ "$size" -ge 1 ] && [ "$size" -le "$2" ] || return 1
    hi_bb head -c "$(($2 + 1))" "$1"
}

hi_config() {
    local data line seen_state seen_kernel
    ROOT_UUID=; ROOT_MARKER_SHA256=; SLOT=; STATE_UUID=; KERNEL_RELEASE=
    seen_state=0; seen_kernel=0
    hi_regular /etc/a733-boot.conf || return 1
    data=$(hi_bounded_read /etc/a733-boot.conf 2048) || return 1
    while IFS= read -r line; do
        case "$line" in
            STATE_UUID=*) [ "$seen_state" = 0 ] || return 1
                seen_state=1; STATE_UUID=${line#STATE_UUID=} ;;
            KERNEL_RELEASE=*) [ "$seen_kernel" = 0 ] || return 1
                seen_kernel=1; KERNEL_RELEASE=${line#KERNEL_RELEASE=} ;;
            *) return 1 ;;
        esac
    done <<END_CONFIG
$data
END_CONFIG
    printf '%s\n' "$data" | hi_bb cmp -s - /etc/a733-boot.conf || return 1
    [ "$seen_state$seen_kernel" = 11 ] && hs_uuid "$STATE_UUID" &&
    [ "$KERNEL_RELEASE" = 6.6.98-a733-diag ] &&
    [ "$(hi_bb uname -r)" = "$KERNEL_RELEASE" ]
}
hi_devices() {
    local attempt data state
    attempt=0
    while [ "$attempt" -lt 10 ]; do
        if data=$(hs_resolve_state "$STATE_UUID"); then break; fi
        attempt=$((attempt + 1))
        [ "$attempt" -ge 10 ] || hi_bb sleep 1 || return 1
    done
    [ "$attempt" -lt 10 ] || return 1
    state=${data#STATE_DEVICE=}
    [ "$data" = "STATE_DEVICE=$state" ] &&
    hi_match "$state" '^/dev/nvme[0-9]+n[0-9]+p4$' || return 1
    STATE_DEVICE=$state
    hs_identity "${state##*/}" || return 1
    STATE_ID=$HS_ID; STATE_PARENT=$HS_PARENT
}
hi_selection() {
    local path data line schema slot uuid hash kernel seen_schema seen_slot seen_uuid seen_hash seen_kernel
    path=$HI_STATE_MOUNT/boot
    hi_directory "$path" && hi_owned "$path" || return 1
    case "$(hi_bb stat -c %a "$path")" in 500|700) ;; *) return 1 ;; esac
    path=$path/selected.conf
    hi_regular "$path" && hi_owned "$path" || return 1
    data=$(hi_bounded_read "$path" 4096) || return 1
    seen_schema=0; seen_slot=0; seen_uuid=0; seen_hash=0; seen_kernel=0
    schema=; slot=; uuid=; hash=; kernel=
    while IFS= read -r line; do
        case "$line" in
            SCHEMA=*) [ "$seen_schema" = 0 ] || return 1; seen_schema=1; schema=${line#SCHEMA=} ;;
            SLOT=*) [ "$seen_slot" = 0 ] || return 1; seen_slot=1; slot=${line#SLOT=} ;;
            ROOT_UUID=*) [ "$seen_uuid" = 0 ] || return 1; seen_uuid=1; uuid=${line#ROOT_UUID=} ;;
            ROOT_MARKER_SHA256=*) [ "$seen_hash" = 0 ] || return 1; seen_hash=1; hash=${line#ROOT_MARKER_SHA256=} ;;
            KERNEL_RELEASE=*) [ "$seen_kernel" = 0 ] || return 1; seen_kernel=1; kernel=${line#KERNEL_RELEASE=} ;;
            *) return 1 ;;
        esac
    done <<END_SELECTION
$data
END_SELECTION
    printf '%s\n' "$data" | hi_bb cmp -s - "$path" || return 1
    [ "$seen_schema$seen_slot$seen_uuid$seen_hash$seen_kernel" = 11111 ] &&
    [ "$schema" = 1 ] && [ "$kernel" = "$KERNEL_RELEASE" ] &&
    hi_match "$hash" '^[0-9a-f]{64}$' || return 1
    case "$slot:$uuid" in
        A:a7330000-0000-4000-8000-00000000000a|B:a7330000-0000-4000-8000-00000000000b) ;;
        *) return 1 ;;
    esac
    SLOT=$slot; ROOT_UUID=$uuid; ROOT_MARKER_SHA256=$hash
    data=$(hs_resolve_root "$STATE_DEVICE" "$STATE_UUID" "$SLOT" "$ROOT_UUID") || return 1
    ROOT_DEVICE=${data#ROOT_DEVICE=}
    case "$SLOT" in A) path=/dev/${STATE_PARENT}p2 ;; B) path=/dev/${STATE_PARENT}p3 ;; esac
    [ "$data" = "ROOT_DEVICE=$path" ] && [ "$ROOT_DEVICE" = "$path" ]
}

# Track only our own successful mounts, newest first. Cleanup never repairs disks.
hi_mount() {
    local target
    target=$1; shift
    hi_bb mount "$@" "$target" || return 1
    HI_MOUNTS="$target $HI_MOUNTS"
}
hi_unmount_state() {
    hi_bb umount "$HI_STATE_MOUNT" || return 1
    # At this point state is the most recently mounted filesystem.
    [ "${HI_MOUNTS%% *}" = "$HI_STATE_MOUNT" ] || return 1
    HI_MOUNTS=${HI_MOUNTS#* }
}
hi_cleanup() {
    local target
    for target in $HI_MOUNTS; do
        case "$target" in
            /newroot/run)
                hi_bb mount --move /newroot/run /run || hi_error "cleanup could not restore /run" ;;
            /newroot/proc|/newroot/sys|/newroot/dev)
                hi_bb mount --move "$target" "/${target##*/}" || hi_error "cleanup could not restore $target" ;;
            /proc|/sys|/dev|/run|/tmp) ;; # Keep the serial recovery environment alive.
            *) hi_bb umount "$target" || hi_error "cleanup could not unmount $target" ;;
        esac
    done
    HI_MOUNTS=
    # Restore only a block flag we changed, after all our mounts are gone.
    if [ "${HI_STATE_RO_OWNED:-0}" = 1 ]; then
        hi_state_restore || hi_error "could not verify safe STATE block-RO cleanup"
    fi
    return 0
}
hi_readonly_root() {
    hi_readonly_mount /newroot
}
hi_readonly_mount() {
    hi_bb cat /proc/self/mountinfo | hi_bb awk '
        $5 == target {
            count++; n=split($6, flags, ","); ro=0; rw=0
            for(i=1;i<=n;i++) { if(flags[i]=="ro") ro=1; if(flags[i]=="rw") rw=1 }
            if(!ro || rw) bad=1
        }
        END { exit (count==1 && !bad) ? 0 : 1 }' target="$1"
}
# Keep this fixed map identical to configs/package_state.py COMPONENTS.
hi_package_items() {
    printf '%s\n' 'dpkg var/lib/dpkg directory' 'apt var/lib/apt directory' \
        'debconf var/cache/debconf directory' 'ucf var/lib/ucf directory' \
        'pam var/lib/pam directory' 'shells var/lib/shells.state file' \
        'systemd-helper var/lib/systemd/deb-systemd-helper-enabled directory' \
        'systemd-catalog var/lib/systemd/catalog directory'
}
hi_package_path() {
    local path kind parent
    path=$1; kind=$2; parent=${path%/*}
    case "$path" in /newroot/*) ;; *) return 1 ;; esac
    while [ "$parent" != /newroot ]; do
        hi_directory "$parent" && hi_owned "$parent" || return 1
        parent=${parent%/*}
    done
    hi_directory /newroot && hi_owned /newroot && hi_owned "$path" || return 1
    case "$kind" in directory) hi_directory "$path" ;; file) hi_regular "$path" ;; *) return 1 ;; esac
}
hi_package_format() {
    local base expected
    base=/newroot/usr/lib/orangepi-hypervisor/package-state
    hi_package_path "$base" directory && hi_package_path "$base/FORMAT" file &&
    hi_package_path "$base/manifest.json" file || return 1
    expected=a733-package-state-v1
    [ "$(hi_size "$base/FORMAT")" = "$((${#expected} + 1))" ] &&
    printf '%s\n' "$expected" | hi_bb cmp -s - "$base/FORMAT"
}
hi_package_mounts() {
    local name path kind source target
    hi_package_format || return 1
    while read -r name path kind; do
        source=/newroot/usr/lib/orangepi-hypervisor/package-state/$name
        target=/newroot/$path
        hi_package_path "$source" "$kind" && hi_package_path "$target" "$kind" || return 1
        hi_mount "$target" --bind "$source" || return 1
        # MS_BIND alone does not apply per-mount read-only flags reliably.
        # The bind is already tracked, so a remount failure is cleaned up too.
        hi_bb mount -o remount,bind,ro,nodev,nosuid "$target" && hi_readonly_mount "$target" || return 1
    done <<END_PACKAGE_ITEMS
$(hi_package_items)
END_PACKAGE_ITEMS
}
hi_root() {
    local path hash
    hi_mount /newroot -t ext4 -o ro,noload,nodev "$ROOT_DEVICE" || return 1
    hi_readonly_root || return 1
    for path in run tmp etc var root home proc sys dev usr usr/lib usr/lib/orangepi-hypervisor; do
        hi_directory "/newroot/$path" || return 1
    done
    [ "$(hi_bb stat -c %a /newroot/etc)" = 755 ] || return 1
    hi_regular /newroot/etc/machine-id && hi_regular /newroot/usr/lib/orangepi-hypervisor/payload.json || return 1
    # Absolute links must be interpreted in the new root, never in initramfs.
    [ "$(hi_bb readlink /newroot/sbin)" = usr/sbin ] &&
    [ "$(hi_bb readlink /newroot/lib)" = usr/lib ] &&
    [ "$(hi_bb readlink /newroot/sbin/init)" = /lib/systemd/systemd ] &&
    [ "$(hi_bb readlink /newroot/usr/lib/ld-linux-aarch64.so.1)" = aarch64-linux-gnu/ld-linux-aarch64.so.1 ] || return 1
    hi_directory /newroot/usr/sbin && hi_directory /newroot/usr/lib/systemd &&
    hi_directory /newroot/usr/lib/aarch64-linux-gnu &&
    hi_regular /newroot/usr/lib/systemd/systemd &&
    hi_regular /newroot/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 &&
    hi_bb test -x /newroot/usr/lib/systemd/systemd &&
    hi_bb test -x /newroot/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 || return 1
    hi_regular /newroot/usr/lib/orangepi-hypervisor/host-management.py &&
    hi_regular /newroot/usr/lib/orangepi-hypervisor/host_config.py &&
    hi_bb test -x /newroot/usr/bin/python3 || return 1
    hash=$(hi_bb sha256sum /newroot/usr/lib/orangepi-hypervisor/payload.json) || return 1
    [ "${hash%% *}" = "$ROOT_MARKER_SHA256" ]
}

hi_owned() {
    local owner mode
    owner=$(hi_bb stat -c %u "$1") && mode=$(hi_bb stat -c %a "$1") || return 1
    [ "$owner" = 0 ] || return 1
    # Reject special bits and group/world writes. Numeric modes from stat are octal.
    case "$mode" in ''|*[!0-7]*|????*) return 1 ;; esac
    [ "$((0$mode & 0022))" = 0 ]
}
hi_state_valid() {
    local path marker expected identity mode
    hi_directory "$HI_STATE_MOUNT" && hi_owned "$HI_STATE_MOUNT" || return 1
    for path in var root home identity; do
        hi_directory "$HI_STATE_MOUNT/$path" && hi_owned "$HI_STATE_MOUNT/$path" || return 1
    done
    path=$HI_STATE_MOUNT/.a733-state
    hi_regular "$path" && hi_owned "$path" || return 1
    expected=$(printf 'a733-state-v1\n%s' "$STATE_UUID")
    [ "$(hi_size "$path")" = "$((${#expected} + 1))" ] || return 1
    marker=$(hi_bounded_read "$path" "$((${#expected} + 1))") || return 1
    [ "$marker" = "$expected" ] || return 1
    printf '%s\n' "$expected" | hi_bb cmp -s - "$path" || return 1
    path=$HI_STATE_MOUNT/identity/machine-id
    hi_regular "$path" && hi_owned "$path" || return 1
    mode=$(hi_bb stat -c %a "$path") || return 1
    case "$mode" in 400|444|600|644) ;; *) return 1 ;; esac
    [ "$(hi_size "$path")" = 33 ] || return 1
    identity=$(hi_bounded_read "$path" 33) || return 1
    hi_match "$identity" '^[0-9a-f]{32}$' && [ "$identity" != 00000000000000000000000000000000 ] || return 1
    printf '%s\n' "$identity" | hi_bb cmp -s - "$path" || return 1
    if [ -n "$HI_MACHINE_ID" ]; then [ "$HI_MACHINE_ID" = "$identity" ] || return 1; fi
    HI_MACHINE_ID=$identity
}
# ext4 superblock bytes are read without mounting. Refuse external journal
# devices/UUIDs before either probe or authorized replay. The pinned state recipe
# uses reserved internal journal inode 8. Byte decoding is endian-independent.
hi_internal_journal() {
    local bytes byte index magic_lo magic_hi compat incompat
    bytes=$(hi_bb od -An -v -tu1 -j 1024 -N 236 "$STATE_DEVICE") || return 1
    index=0; magic_lo=; magic_hi=; compat=; incompat=
    for byte in $bytes; do
        case "$byte" in ''|*[!0-9]*|????*) return 1 ;; esac
        [ "$byte" -le 255 ] || return 1
        case "$index" in
            56) magic_lo=$byte ;; 57) magic_hi=$byte ;;
            92) compat=$byte ;; 96) incompat=$byte ;;
            208|209|210|211|212|213|214|215|216|217|218|219|220|221|222|223|225|226|227|228|229|230|231)
                [ "$byte" = 0 ] || return 1 ;;
            224) [ "$byte" = 8 ] || return 1 ;;
        esac
        index=$((index + 1))
    done
    [ "$index" = 236 ] && [ "$magic_lo" = 83 ] && [ "$magic_hi" = 239 ] &&
    [ "$((compat & 4))" = 4 ] && [ "$((incompat & 8))" = 0 ]
}
hi_state_same() {
    hs_identity "${STATE_DEVICE##*/}" && [ "$HS_ID" = "$STATE_ID" ] && [ "$HS_PARENT" = "$STATE_PARENT" ] &&
    hs_filesystem "${STATE_DEVICE##*/}" && [ "$HS_UUID" = "$STATE_UUID" ] && [ "$HS_TYPE" = ext4 ] &&
    hs_idle "${STATE_DEVICE##*/}" "$STATE_ID" "$1" && hs_table "$STATE_PARENT"
}
hi_state_restore() {
    [ "${HI_STATE_RO_OWNED:-0}" = 1 ] || return 0
    # hs_idle checks mountinfo as well as holders. Never clear RO after a failed
    # unmount or against a substituted device, even in the failure cleanup path.
    hi_state_same readonly && hi_internal_journal || return 1
    [ "$HI_STATE_ORIGINAL_RO" = 0 ] &&
    [ "$(hi_bb blockdev --getro "$STATE_DEVICE")" = 1 ] || return 1
    hi_bb blockdev --setrw "$STATE_DEVICE" &&
    [ "$(hi_bb blockdev --getro "$STATE_DEVICE")" = 0 ] || return 1
    HI_STATE_RO_OWNED=0
}
hi_state() {
    hi_bb mkdir -m 0700 "$HI_STATE_MOUNT" || return 1
    hi_state_same writable && hi_internal_journal || return 1
    HI_STATE_ORIGINAL_RO=$(hi_bb blockdev --getro "$STATE_DEVICE") || return 1
    [ "$HI_STATE_ORIGINAL_RO" = 0 ] || return 1
    # ro,noload alone permits ext4 orphan/error handling writes on this kernel.
    # Claim cleanup ownership before the ioctl, whose failure may be ambiguous.
    HI_STATE_RO_OWNED=1
    hi_bb blockdev --setro "$STATE_DEVICE" &&
    [ "$(hi_bb blockdev --getro "$STATE_DEVICE")" = 1 ] &&
    hi_state_same readonly || return 1
    hi_mount "$HI_STATE_MOUNT" -t ext4 -o ro,noload,nodev,nosuid "$STATE_DEVICE" || return 1
    hi_state_valid || return 1
    hi_unmount_state || return 1
    hi_state_restore || return 1
    hi_state_same writable && hi_internal_journal || return 1
    # Journal replay is permitted only on selected, prevalidated NVMe state.
    hi_mount "$HI_STATE_MOUNT" -t ext4 -o rw,nodev,nosuid "$STATE_DEVICE" || return 1
    hi_state_valid
}
hi_runtime() {
    local path
    for path in var root home; do
        hi_mount "/newroot/$path" --bind "/newroot/run/a733-state/$path" || return 1
    done
    hi_package_mounts || return 1
    # Overlay inherits the upper directory's mode for the merged /etc root.
    hi_bb mkdir -m 0755 /newroot/run/etc-upper &&
    hi_bb mkdir -m 0700 /newroot/run/etc-work || return 1
    hi_mount /newroot/etc -t overlay -o lowerdir=/newroot/etc,upperdir=/newroot/run/etc-upper,workdir=/newroot/run/etc-work overlay || return 1
    hi_mount /newroot/etc/machine-id --bind /newroot/run/a733-state/identity/machine-id || return 1
    hi_mount /newroot/tmp -t tmpfs -o size=64M,mode=1777,nodev,nosuid tmpfs || return 1
}
hi_forget_mount() {
    local target kept
    kept=
    for target in $HI_MOUNTS; do
        [ "$target" = "$1" ] || kept="$kept$target "
    done
    HI_MOUNTS=$kept
}
hi_drop_mount() {
    hi_bb umount "$1" || return 1
    hi_forget_mount "$1"
}
hi_move() {
    local target kept
    hi_bb mount --move "$1" "$2" || return 1
    if [ "$1" = /run ]; then
        kept=
        for target in $HI_MOUNTS; do
            case "$target" in
                /run|/newroot) ;;
                /run/*) kept="$kept/newroot$target " ;;
                *) kept="$kept$target " ;;
            esac
        done
        # The moved child must unmount before restoring /run and dropping root.
        HI_MOUNTS="$kept/newroot/run /newroot "
        HI_STATE_MOUNT=/newroot/run/a733-state
    else
        hi_forget_mount "$1"
        HI_MOUNTS="$2 $HI_MOUNTS"
    fi
}
# The final exec transfers PID 1 ownership to switch_root. Failure inside that
# applet or in the new dynamic init cannot return to this recovery shell.
hi_switch() { exec /bin/busybox switch_root /newroot /sbin/init; }
hi_console() { exec </dev/console >/dev/console 2>&1; }
hi_management() {
    hi_bb chroot /newroot /usr/bin/python3 -I -B /usr/lib/orangepi-hypervisor/host-management.py prepare
}
hi_handoff() {
    HI_MOUNTS=; HI_MACHINE_ID=; HI_STATE_MOUNT=/run/a733-state
    HI_STATE_RO_OWNED=0; HI_STATE_ORIGINAL_RO=
    hi_mount /proc -t proc -o nosuid,nodev,noexec proc &&
    hi_mount /sys -t sysfs -o nosuid,nodev,noexec sysfs &&
    hi_mount /dev -t devtmpfs -o nosuid devtmpfs &&
    hi_console &&
    hi_mount /run -t tmpfs -o size=64M,mode=0755,nodev,nosuid tmpfs &&
    hi_mount /tmp -t tmpfs -o size=64M,mode=1777,nodev,nosuid tmpfs || return 1
    hi_resolver && hi_config && hi_devices && hi_state && hi_selection && hi_root &&
    hi_move /run /newroot/run && hi_runtime || return 1
    # Drop empty old RAM mounts so switch_root does not strand these filesystems.
    hi_drop_mount /tmp || return 1
    # Retarget cleanup after each successful move, including partial failure.
    hi_move /proc /newroot/proc || return 1
    hi_move /sys /newroot/sys || return 1
    hi_move /dev /newroot/dev || return 1
    hi_management || return 1
    hi_switch
    # Real switch_root never returns on success.
}
hi_recovery() {
    hi_error 'handoff failed; physical serial root recovery console (no automatic reboot)'
    while :; do
        /bin/busybox sh -i </dev/console >/dev/console 2>&1
        /bin/busybox sleep 1
    done
}
hi_main() {
    if hi_handoff; then return 0; fi
    hi_error 'storage or boot validation failed'
    hi_cleanup
    hi_recovery
}

if [ "$$" = 1 ] && [ "${0##*/}" = init ]; then
    hi_main
fi
