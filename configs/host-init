#!/bin/sh
# A733 host initramfs PID 1. Sourcing defines functions only, for fixture tests.
# Production dependencies are fixed; never source configuration as shell code.
hi_bb() { /bin/busybox "$@"; }
hi_resolver() { . /etc/host-storage-resolver.sh; }
hi_error() { printf '%s\n' "A733 host handoff: $*" >&2; return 1; }
hi_match() { printf '%s\n' "$1" | hi_bb grep -Eq "$2"; }
hi_regular() { hi_bb test -f "$1" && ! hi_bb test -L "$1"; }
hi_directory() { hi_bb test -d "$1" && ! hi_bb test -L "$1"; }
hi_size() { hi_bb stat -c %s "$1"; }

hi_config() {
    local data line bytes size seen_root seen_state seen_hash seen_kernel
    ROOT_UUID=; STATE_UUID=; ROOT_MARKER_SHA256=; KERNEL_RELEASE=
    seen_root=0; seen_state=0; seen_hash=0; seen_kernel=0; bytes=0
    hi_regular /etc/a733-boot.conf || return 1
    data=$(hi_bb cat /etc/a733-boot.conf) || return 1
    size=$(hi_size /etc/a733-boot.conf) || return 1
    while IFS= read -r line; do
        bytes=$((bytes + ${#line} + 1))
        case "$line" in
            ROOT_UUID=*) [ "$seen_root" = 0 ] || return 1
                seen_root=1; ROOT_UUID=${line#ROOT_UUID=} ;;
            STATE_UUID=*) [ "$seen_state" = 0 ] || return 1
                seen_state=1; STATE_UUID=${line#STATE_UUID=} ;;
            ROOT_MARKER_SHA256=*) [ "$seen_hash" = 0 ] || return 1
                seen_hash=1; ROOT_MARKER_SHA256=${line#ROOT_MARKER_SHA256=} ;;
            KERNEL_RELEASE=*) [ "$seen_kernel" = 0 ] || return 1
                seen_kernel=1; KERNEL_RELEASE=${line#KERNEL_RELEASE=} ;;
            *) return 1 ;;
        esac
    done <<END_CONFIG
$data
END_CONFIG
    # Exact byte length also rejects stripped NULs and missing/extra newlines.
    printf '%s\n' "$data" | hi_bb cmp -s - /etc/a733-boot.conf || return 1
    [ "$bytes" = "$size" ] && [ "$seen_root$seen_state$seen_hash$seen_kernel" = 1111 ] &&
    hs_uuid "$ROOT_UUID" && hs_uuid "$STATE_UUID" && [ "$ROOT_UUID" != "$STATE_UUID" ] &&
    hi_match "$ROOT_MARKER_SHA256" '^[0-9a-f]{64}$' &&
    [ "$KERNEL_RELEASE" = 6.6.98-a733-diag ] &&
    [ "$(hi_bb uname -r)" = "$KERNEL_RELEASE" ]
}

hi_devices() {
    local attempt data line root state
    attempt=0; data=
    while [ "$attempt" -lt 10 ]; do
        if data=$(hs_resolve "$ROOT_UUID" "$STATE_UUID"); then break; fi
        attempt=$((attempt + 1))
        [ "$attempt" -ge 10 ] || hi_bb sleep 1 || return 1
    done
    [ "$attempt" -lt 10 ] || return 1
    root=; state=
    while IFS= read -r line; do
        case "$line" in
            ROOT_DEVICE=*) [ -z "$root" ] || return 1; root=${line#ROOT_DEVICE=} ;;
            STATE_DEVICE=*) [ -z "$state" ] || return 1; state=${line#STATE_DEVICE=} ;;
            *) return 1 ;;
        esac
    done <<END_DEVICES
$data
END_DEVICES
    hi_match "$root" '^/dev/nvme[0-9]+n[0-9]+p[1-9][0-9]*$' &&
    hi_match "$state" '^/dev/nvme[0-9]+n[0-9]+p[1-9][0-9]*$' && [ "$root" != "$state" ] || return 1
    ROOT_DEVICE=$root; STATE_DEVICE=$state
    hs_identity "${state##*/}" || return 1
    STATE_ID=$HS_ID; STATE_PARENT=$HS_PARENT
}

# Track only our own successful mounts, newest first. Cleanup never repairs disks.
hi_mount() {
    local target
    target=$1; shift
    hi_bb mount "$@" "$target" || return 1
    HI_MOUNTS="$target $HI_MOUNTS"
}
hi_unmount_state() {
    hi_bb umount /newroot/run/a733-state || return 1
    # At this point state is the most recently mounted filesystem.
    [ "${HI_MOUNTS%% *}" = /newroot/run/a733-state ] || return 1
    HI_MOUNTS=${HI_MOUNTS#* }
}
hi_cleanup() {
    local target
    for target in $HI_MOUNTS; do
        case "$target" in
            /newroot/proc|/newroot/sys|/newroot/dev)
                hi_bb mount --move "$target" "/${target##*/}" || hi_error "cleanup could not restore $target" ;;
            /proc|/sys|/dev|/run|/tmp) ;; # Keep the serial recovery environment alive.
            *) hi_bb umount "$target" || hi_error "cleanup could not unmount $target" ;;
        esac
    done
    HI_MOUNTS=
}
hi_readonly_root() {
    hi_bb cat /proc/self/mountinfo | hi_bb awk '
        $5 == "/newroot" {
            count++; n=split($6, flags, ","); ro=0; rw=0
            for(i=1;i<=n;i++) { if(flags[i]=="ro") ro=1; if(flags[i]=="rw") rw=1 }
            if(!ro || rw) bad=1
        }
        END { exit (count==1 && !bad) ? 0 : 1 }'
}
hi_root() {
    local path hash
    hi_mount /newroot -t ext4 -o ro,noload,nodev "$ROOT_DEVICE" || return 1
    hi_readonly_root || return 1
    for path in run tmp etc var root home proc sys dev usr usr/lib usr/lib/orangepi-hypervisor; do
        hi_directory "/newroot/$path" || return 1
    done
    [ "$(hi_bb stat -c %a /newroot/etc)" = 755 ] || return 1
    hi_regular /newroot/etc/machine-id && hi_regular /newroot/usr/lib/orangepi-hypervisor/payload.json || return 1
    # Absolute links must be interpreted in the new root, never in initramfs.
    [ "$(hi_bb readlink /newroot/sbin)" = usr/sbin ] &&
    [ "$(hi_bb readlink /newroot/lib)" = usr/lib ] &&
    [ "$(hi_bb readlink /newroot/sbin/init)" = /lib/systemd/systemd ] &&
    [ "$(hi_bb readlink /newroot/usr/lib/ld-linux-aarch64.so.1)" = aarch64-linux-gnu/ld-linux-aarch64.so.1 ] || return 1
    hi_directory /newroot/usr/sbin && hi_directory /newroot/usr/lib/systemd &&
    hi_directory /newroot/usr/lib/aarch64-linux-gnu &&
    hi_regular /newroot/usr/lib/systemd/systemd &&
    hi_regular /newroot/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 &&
    hi_bb test -x /newroot/usr/lib/systemd/systemd &&
    hi_bb test -x /newroot/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 || return 1
    hash=$(hi_bb sha256sum /newroot/usr/lib/orangepi-hypervisor/payload.json) || return 1
    [ "${hash%% *}" = "$ROOT_MARKER_SHA256" ]
}

hi_owned() {
    local owner mode
    owner=$(hi_bb stat -c %u "$1") && mode=$(hi_bb stat -c %a "$1") || return 1
    [ "$owner" = 0 ] || return 1
    # Reject special bits and group/world writes. Numeric modes from stat are octal.
    case "$mode" in ''|*[!0-7]*|????*) return 1 ;; esac
    [ "$((0$mode & 0022))" = 0 ]
}
hi_state_valid() {
    local path marker expected identity mode
    hi_directory /newroot/run/a733-state && hi_owned /newroot/run/a733-state || return 1
    for path in var root home identity; do
        hi_directory "/newroot/run/a733-state/$path" && hi_owned "/newroot/run/a733-state/$path" || return 1
    done
    path=/newroot/run/a733-state/.a733-state
    hi_regular "$path" && hi_owned "$path" || return 1
    marker=$(hi_bb cat "$path") || return 1
    expected=$(printf 'a733-state-v1\n%s' "$STATE_UUID")
    [ "$marker" = "$expected" ] && [ "$(hi_size "$path")" = "$((${#expected} + 1))" ] || return 1
    printf '%s\n' "$expected" | hi_bb cmp -s - "$path" || return 1
    path=/newroot/run/a733-state/identity/machine-id
    hi_regular "$path" && hi_owned "$path" || return 1
    mode=$(hi_bb stat -c %a "$path") || return 1
    case "$mode" in 400|444|600|644) ;; *) return 1 ;; esac
    [ "$(hi_size "$path")" = 33 ] || return 1
    identity=$(hi_bb cat "$path") || return 1
    hi_match "$identity" '^[0-9a-f]{32}$' && [ "$identity" != 00000000000000000000000000000000 ] || return 1
    printf '%s\n' "$identity" | hi_bb cmp -s - "$path" || return 1
    if [ -n "$HI_MACHINE_ID" ]; then [ "$HI_MACHINE_ID" = "$identity" ] || return 1; fi
    HI_MACHINE_ID=$identity
}
hi_state() {
    hi_mount /newroot/run -t tmpfs -o size=64M,mode=0755,nodev,nosuid tmpfs || return 1
    hi_bb mkdir -m 0700 /newroot/run/a733-state || return 1
    hi_mount /newroot/run/a733-state -t ext4 -o ro,noload,nodev,nosuid "$STATE_DEVICE" || return 1
    hi_state_valid || return 1
    hi_unmount_state || return 1
    hs_identity "${STATE_DEVICE##*/}" && [ "$HS_ID" = "$STATE_ID" ] && [ "$HS_PARENT" = "$STATE_PARENT" ] &&
    hs_filesystem "${STATE_DEVICE##*/}" && [ "$HS_UUID" = "$STATE_UUID" ] && [ "$HS_TYPE" = ext4 ] || return 1
    # Journal replay is permitted only on selected, prevalidated NVMe state.
    hi_mount /newroot/run/a733-state -t ext4 -o rw,nodev,nosuid "$STATE_DEVICE" || return 1
    hi_state_valid
}
hi_runtime() {
    local path
    for path in var root home; do
        hi_mount "/newroot/$path" --bind "/newroot/run/a733-state/$path" || return 1
    done
    # Overlay inherits the upper directory's mode for the merged /etc root.
    hi_bb mkdir -m 0755 /newroot/run/etc-upper &&
    hi_bb mkdir -m 0700 /newroot/run/etc-work || return 1
    hi_mount /newroot/etc -t overlay -o lowerdir=/newroot/etc,upperdir=/newroot/run/etc-upper,workdir=/newroot/run/etc-work overlay || return 1
    hi_mount /newroot/etc/machine-id --bind /newroot/run/a733-state/identity/machine-id || return 1
    hi_mount /newroot/tmp -t tmpfs -o size=64M,mode=1777,nodev,nosuid tmpfs || return 1
}
hi_forget_mount() {
    local target kept
    kept=
    for target in $HI_MOUNTS; do
        [ "$target" = "$1" ] || kept="$kept$target "
    done
    HI_MOUNTS=$kept
}
hi_drop_mount() {
    hi_bb umount "$1" || return 1
    hi_forget_mount "$1"
}
hi_move() {
    hi_bb mount --move "$1" "$2" || return 1
    hi_forget_mount "$1"
    # Restoring pseudo filesystems must precede unmounting their parent root.
    HI_MOUNTS="$2 $HI_MOUNTS"
}
# The final exec transfers PID 1 ownership to switch_root. Failure inside that
# applet or in the new dynamic init cannot return to this recovery shell.
hi_switch() { exec /bin/busybox switch_root /newroot /sbin/init; }
hi_console() { exec </dev/console >/dev/console 2>&1; }
hi_handoff() {
    HI_MOUNTS=; HI_MACHINE_ID=
    hi_mount /proc -t proc -o nosuid,nodev,noexec proc &&
    hi_mount /sys -t sysfs -o nosuid,nodev,noexec sysfs &&
    hi_mount /dev -t devtmpfs -o nosuid devtmpfs &&
    hi_console &&
    hi_mount /run -t tmpfs -o size=64M,mode=0755,nodev,nosuid tmpfs &&
    hi_mount /tmp -t tmpfs -o size=64M,mode=1777,nodev,nosuid tmpfs || return 1
    hi_resolver && hi_config && hi_devices && hi_root && hi_state && hi_runtime || return 1
    # Drop empty old RAM mounts so switch_root does not strand these filesystems.
    hi_drop_mount /tmp && hi_drop_mount /run || return 1
    # Retarget cleanup after each successful move, including partial failure.
    hi_move /proc /newroot/proc || return 1
    hi_move /sys /newroot/sys || return 1
    hi_move /dev /newroot/dev || return 1
    hi_switch
    # Real switch_root never returns on success.
}
hi_recovery() {
    hi_error 'handoff failed; physical serial root recovery console (no automatic reboot)'
    while :; do
        /bin/busybox sh -i </dev/console >/dev/console 2>&1
        /bin/busybox sleep 1
    done
}
hi_main() {
    if hi_handoff; then return 0; fi
    hi_error 'storage or boot validation failed'
    hi_cleanup
    hi_recovery
}

if [ "$$" = 1 ] && [ "${0##*/}" = init ]; then
    hi_main
fi
