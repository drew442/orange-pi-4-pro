    "source_text": "import hashlib,json,os,subprocess,time\nfrom pathlib import Path\nPROJECT=Path('/var/lib/a733-maintenance-validation-20261108-01/project')\nBASE=Path('/var/lib/a733-matched-updates-20261109-01')\nPAYLOAD=Path('/var/lib/a733-clean-replay-20261106/host-roots-timesync-runtime-fixes-01/work/project/out/host-payload-timesync-runtime-fixes-01')\nPIN='4f28d75a14323c52aa976b00f957b56913b75472a07a717672abd33d439b97b9'\nlock=json.loads((BASE/'source-lock.json').read_text())\ndef sources():\n for name,record in lock.items():\n  path=PROJECT/name\n  assert path.is_file() and not path.is_symlink(),name\n  data=path.read_bytes()\n  assert {'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}==record,name\n\ndef resources():\n v=os.statvfs(BASE);free=v.f_bavail*v.f_frsize\n mem=int(next(x.split()[1] for x in Path('/proc/meminfo').read_text().splitlines() if x.startswith('MemAvailable:')))*1024\n assert free>=3_000_000_000 and mem>=1_000_000_000,(free,mem)\n return {'free_bytes':free,'available_memory_bytes':mem}\nsources()\nassert resources()['free_bytes']>=2*4294967296+1073741824\nbody=(PAYLOAD/'manifest.json').read_bytes()\nassert len(body)==32613 and hashlib.sha256(body).hexdigest()==PIN\nbefore={name:(p.stat().st_dev,p.stat().st_ino,p.stat().st_mode,p.stat().st_uid,p.stat().st_gid,p.stat().st_nlink,p.stat().st_size,p.stat().st_mtime_ns,p.stat().st_ctime_ns) for name in ['manifest.json','root-A.ext4','root-B.ext4'] for p in [PAYLOAD/name]}\nstarted=time.monotonic();samples=[resources()]\nfor slot in ('A','B'):\n output=BASE/('candidate-'+slot)\n assert not output.exists()\n print('Preparing current root slot '+slot+' as regular files only',flush=True)\n subprocess.run(['python3','-I','-B',str(PROJECT/'scripts/prepare-host-update.py'),str(PAYLOAD/('root-'+slot+'.ext4')),str(output),'--slot',slot,'--payload-manifest',str(PAYLOAD/'manifest.json'),'--manifest-sha256',PIN,'--storage-kind','external'],check=True)\n samples.append(resources())\npackage=PROJECT/'out/maintenance-tools-matched-20261109-01'\nassert not package.exists()\nprint('Packaging current portable maintenance source closure',flush=True)\nsubprocess.run(['python3','-I','-B',str(PROJECT/'build/maintenance-tools.py'),str(package)],check=True)\nsamples.append(resources());sources()\nfor name,wanted in before.items():\n p=PAYLOAD/name;s=p.stat();assert (s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)==wanted,name\nreport={'schema':1,'classification':'regular-file candidate and portable tools preparation only','hardware_acceptance':False,'source_closure':lock,'source_payload_manifest':{'path':str(PAYLOAD/'manifest.json'),'bytes':len(body),'sha256':PIN},'elapsed_seconds':time.monotonic()-started,'resources':samples,'original_inputs_unchanged':True,'outputs':{},'maintenance_package':str(package),'physical_storage_written':False}\nfor slot in ('A','B'):\n directory=BASE/('candidate-'+slot)\n report['outputs'][slot]={name:{'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for name in ['candidate.json','manifest.json','selected.conf'] for p in [directory/name]}\n report['outputs'][slot]['root.ext4']=json.loads((directory/'candidate.json').read_text())['root']\nreport['package_files']={name:{'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for name in ['manifest.json','tools.tar.gz'] for p in [package/name]}\nfd=os.open(BASE/'result.json',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)\nwith os.fdopen(fd,'w') as f:json.dump(report,f,indent=2);f.write('\\n');f.flush();os.fsync(f.fileno())\nfd=os.open(BASE,os.O_RDONLY|os.O_DIRECTORY);os.fsync(fd);os.close(fd)\nprint('Prepared both candidates and portable package; independent artifact review required',flush=True)\n",
